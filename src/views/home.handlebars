{{!-- Muestra los productos agregados hasta el momento --}}
<div>
    <h1>
        Productos:
    </h1>
    <button><a href="/profile">Perfil</a></button><br><br>
    <button><a href="/api/sessions/logout" style="color: red;">Logout</a></button><br>

    {{#each products}}
        <div>
            <h2>
                Title: {{this.title}}
            </h2><br>
            <div>
                <h2>Id:</h2><h2>{{this._id}}</h2>
            </div><br>
            <h2>
                description: {{this.description}}
            </h2><br>
            <h2>
                price: {{this.price}}
            </h2><br>
            <h2>
                img: {{this.img}}
            </h2><br>
            <h2>
                code: {{this.code}}
            </h2><br>
            <h2>
                stock: {{this.stock}}
            </h2><br>
            <h2>
                status: {{this.estado}}
            </h2><br>
            <h2>
                category: {{this.category}}
            </h2><br>
            <hr>
        </div>
    {{/each}}
</div>
