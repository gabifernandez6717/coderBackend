<h1>Register</h1>
<form action="/api/sessions/register" method="post">
    <label for="first_name">First Name</label>
    <input type="text" name="first_name" id="" required>
    <br>
    <label for="last_name">Last Name</label>
    <input type="text" name="last_name" id=""required>
    <br>
    <label for="password">Password</label>
    <input type="text" name="password" id=""required>
    <br>
    <label for="email">Email</label>
    <input type="email" name="email" id=""required>
    <br>
    <label for="age">Age</label>
    <input type="number" name="age" id=""required>
    <br>
    <button type="submit">Register</button>
</form>
<button><a href="/login">Login</a></button>
<br>
<button><a href="/api/sessions/github">GITHUB</a></button>

<hr>